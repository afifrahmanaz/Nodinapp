{
    "name": "nodin-widget",
    "version": "1.0.0",
    "description": "Desktop widget untuk generate nomor Nodin/LK Lantaskim Kanim PKP",
    "scripts": {
        "start": "node start.js",
        "install-app": "cd app && npm install",
        "setup": "npm install && cd app && npm install",
        "build": "electron-builder --win"
    },
    "author": "Nodin App",
    "license": "MIT",
    "devDependencies": {
        "electron": "^33.4.11",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.nodinapp.widget",
        "productName": "Nodin Widget",
        "directories": {
            "app": "app",
            "output": "dist"
        },
        "files": [
            "**/*",
            "!**/public/*.csv",
            "!**/public/Logo Nodin app.png",
            "!**/public/Logo Nodin app resized.png"
        ],
        "asar": true,
        "compression": "maximum",
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": ["x64"]
                }
            ],
            "icon": "app/public/icon.ico"
        },
        "nsis": {
            "artifactName": "NodinApp-Setup-${version}.exe",
            "installerIcon": "app/public/icon.ico",
            "uninstallerIcon": "app/public/icon.ico",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Nodin Widget"
        }
    },
    "dependencies": {
        "jimp": "^1.6.0",
        "png-to-ico": "^3.0.1"
    }
}